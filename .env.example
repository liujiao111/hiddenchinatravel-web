# Copy to .env.local for local / set in Vercel Project → Settings → Environment Variables
# Must match the canonical host you choose in Vercel (apex OR www — pick one).
# Sitemap, robots, and Open Graph URLs all use this value.
NEXT_PUBLIC_SITE_URL=https://hiddenchinatravel.com

# Google Analytics 4 Measurement ID (Admin → Data streams → Web)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# WhatsApp Business chat (optional overrides — defaults are in src/lib/whatsapp.ts)
# NEXT_PUBLIC_WHATSAPP_CHAT_URL=https://wa.me/message/BMLOZTJY2QDXG1
# NEXT_PUBLIC_WHATSAPP_NUMBER=639773450712
# NEXT_PUBLIC_WHATSAPP_QR_PATH=/brand/whatsapp-qr-card.webp

# Form notifications via Resend (required on Vercel for contact / planner / services)
# RESEND_API_KEY=re_xxxxxxxx
# After domain is verified in Resend:
# RESEND_FROM=Hidden China Travel <noreply@hiddenchinatravel.com>
# FORM_NOTIFY_EMAIL=joy.liu@hiddenchinatravel.com

